pipeline {
    agent any

    parameters {
        string(name: 'version', defaultValue: '1.0.0', description: '镜像版本号')
        string(name: 'branch', defaultValue: 'codex/reminder-production-domain', description: '构建分支')
    }

    environment {
        NEXUS_REGISTRY_URL   = '127.0.0.1:3000'
        DOCKER_IMAGE_NAME    = 'admin/reminder-backend'
        DOCKER_IMAGE_TAG     = "${params.version}"
        NEXUS_CREDENTIALS_ID = 'nexus-repo-credentials'
        SAAS_STORAGE_CREDENTIALS_ID = 'reminder-saas-storage-app-probe'
        MAVEN_MIRROR_URL     = 'http://dev-platform-reposilite:8080/releases'
        REMINDER_STATE_DIR   = '/opt/saas-app/reminder/deploy-state'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!(params.version ==~ /[0-9A-Za-z][0-9A-Za-z._-]*/)) {
                        error('version contains unsupported characters')
                    }
                }
            }
        }

        stage('Checkout Code') {
            steps {
                cleanWs()
                script {
                    def sourceUrl = scm.userRemoteConfigs[0].url
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${params.branch}"]],
                        userRemoteConfigs: [[url: sourceUrl]],
                        extensions: [[$class: 'CloneOption', shallow: true, noTags: true, timeout: 20]]
                    ])
                }
            }
        }

        stage('Maven Test & Package') {
            agent {
                docker {
                    image 'maven:3.8.5-openjdk-17'
                    args '--entrypoint="" --network dev-platform'
                    reuseNode true
                }
            }
            steps {
                writeFile file: 'ci-maven-settings.xml', text: """<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <mirrors>
    <mirror>
      <id>wwmty-reposilite</id>
      <url>${MAVEN_MIRROR_URL}</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
"""
                sh 'mvn -s ci-maven-settings.xml -f reminder-backend/pom.xml clean test package -B'
                sh 'bash reminder-backend/scripts/assert-monolith.sh'
                sh 'bash reminder-backend/scripts/test-assert-monolith-portability.sh'
                sh 'bash reminder-backend/deploy/test-shared-infrastructure.sh'
                sh 'bash reminder-backend/deploy/test-deploy-reminder.sh'
                sh 'bash reminder-backend/deploy/test-deploy-reminder-portability.sh'
                sh 'bash reminder-backend/deploy/test-bootstrap-reminder-schema.sh'
                sh 'bash reminder-backend/deploy/test-reminder-gateway-contract.sh'
                sh 'bash reminder-backend/deploy/test-reminder-gateway-installer.sh'
                sh 'bash reminder-backend/deploy/nginx/test-issue-reminder-certificate.sh'
                stash name: 'reminder-jar', includes: 'reminder-backend/target/reminder-backend-*.jar'
            }
        }

        stage('Build & Push Image') {
            steps {
                unstash 'reminder-jar'
                sh 'bash reminder-backend/deploy/test-runtime-network-topology.sh'
                withCredentials([usernamePassword(
                    credentialsId: NEXUS_CREDENTIALS_ID,
                    usernameVariable: 'NEXUS_USERNAME',
                    passwordVariable: 'NEXUS_PASSWORD'
                )]) {
                    sh '''#!/usr/bin/env bash
set -Eeuo pipefail
image="${NEXUS_REGISTRY_URL}/${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"
echo "$NEXUS_PASSWORD" | docker login -u "$NEXUS_USERNAME" --password-stdin "$NEXUS_REGISTRY_URL"
docker build --build-arg 'JAR_FILE=target/reminder-backend-*.jar' -t "$image" reminder-backend
docker push "$image"
docker tag "$image" "${NEXUS_REGISTRY_URL}/${DOCKER_IMAGE_NAME}:latest"
docker push "${NEXUS_REGISTRY_URL}/${DOCKER_IMAGE_NAME}:latest"
'''
                }
            }
        }

        stage('Initialize Reminder Schema') {
            steps {
                sh 'bash reminder-backend/deploy/bootstrap-reminder-schema.sh'
            }
        }

        stage('Deploy Reminder Only') {
            steps {
                withCredentials([
                    file(credentialsId: 'reminder-runtime-env', variable: 'REMINDER_RUNTIME_ENV_SOURCE'),
                    usernamePassword(
                        credentialsId: SAAS_STORAGE_CREDENTIALS_ID,
                        usernameVariable: 'REMINDER_STORAGE_APP_ID',
                        passwordVariable: 'REMINDER_STORAGE_SECRET_CODE'
                    )
                ]) {
                    sh '''#!/usr/bin/env bash
set -Eeuo pipefail
set +x
deploy_env="$WORKSPACE/.reminder-deploy.env"
cleanup() { rm -f "$deploy_env"; }
trap cleanup EXIT
install -m 600 "$REMINDER_RUNTIME_ENV_SOURCE" "$deploy_env"
printf '\nSAAS_STORAGE_APP_ID=%s\nSAAS_STORAGE_SECRET_CODE=%s\n' \
  "$REMINDER_STORAGE_APP_ID" "$REMINDER_STORAGE_SECRET_CODE" >> "$deploy_env"

export REMINDER_ENV_FILE="$deploy_env"
export REMINDER_IMAGE="${NEXUS_REGISTRY_URL}/${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"
export REMINDER_COMPOSE_FILE="$WORKSPACE/reminder-backend/deploy/docker-compose.reminder.yml"
bash "$WORKSPACE/reminder-backend/deploy/deploy-reminder.sh"
'''
                }
            }
        }

    }

    post {
        always {
            sh 'rm -f "$WORKSPACE/.reminder-deploy.env" "$WORKSPACE/ci-maven-settings.xml"'
            sh 'docker logout "$NEXUS_REGISTRY_URL" || true'
        }
    }
}
