REMINDER_IMAGE=127.0.0.1:3000/admin/reminder-backend:1.0.0
REMINDER_HOST_PORT=18080
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

DB_URL=jdbc:postgresql://saas-postgres:5432/saas-admin?timezone=Asia/Shanghai
DB_USERNAME=pguser
DB_PASSWORD=change-me
DB_SCHEMA=reminder

REDIS_HOST=saas-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=9

# Generate one line with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=replace-with-base64-output
JWT_EXPIRATION_MS=2592000000
FRONTEND_URL=https://wwmty.cn
CORS_ALLOWED_ORIGINS=https://wwmty.cn,https://www.wwmty.cn

WECHAT_APP_ID=replace-me
WECHAT_APP_SECRET=replace-me
WECHAT_NOTIFICATION_TEMPLATE_ID=

SAAS_STORAGE_BASE_URL=http://saas-admin-backend:8080
SAAS_STORAGE_APP_ID=injected-from-jenkins-credential
SAAS_STORAGE_SECRET_CODE=injected-from-jenkins-credential
SAAS_STORAGE_BIZ_DIR=avatars
SAAS_STORAGE_MAX_SIZE_BYTES=5242880

NACOS_ENABLED=false
NACOS_SERVER_ADDR=saas-nacos:8848
NACOS_NAMESPACE=reminder
EMAIL_PROVIDER=none
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
